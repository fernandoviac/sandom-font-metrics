{
  "fmt": { "exclude": ["."] },
  "name": "@sandom/font-metrics",
  "version": "0.2.0",
  "exports": "./dist/font-metrics.wasm",
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write tools/build-wasm.js",
    "build:check": "deno run --allow-read --allow-write tools/build-wasm.js --check",
    "test": "deno test -A test/",
    "test:browser": "deno run -A tools/browser-evidence.js",
    "package:check": "deno run -A tools/check-package.js"
  }
}
