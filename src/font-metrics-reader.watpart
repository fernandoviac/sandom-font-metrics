(func $fm_be16 (param $p i32) (result i32)
  (i32.or (i32.shl (i32.load8_u (local.get $p)) (i32.const 8))
          (i32.load8_u offset=1 (local.get $p))))
(func $fm_be16s (param $p i32) (result i32)
  (i32.shr_s (i32.shl (call $fm_be16 (local.get $p)) (i32.const 16)) (i32.const 16)))
(func $fm_be32 (param $p i32) (result i32)
  (i32.or
    (i32.shl (call $fm_be16 (local.get $p)) (i32.const 16))
    (call $fm_be16 (i32.add (local.get $p) (i32.const 2)))))

(func $fm_find_table (param $font i32) (param $flen i32) (param $sfnt i32)
  (param $tag i32) (param $minlen i32) (result i64)
  (local $base i64) (local $end i64) (local $n i32) (local $i i32)
  (local $rec i32) (local $off i64) (local $len i64) (local $p i32)
  (local.set $base
    (i64.sub (i64.extend_i32_u (local.get $sfnt))
             (i64.extend_i32_u (local.get $font))))
  (if (i32.or (i64.lt_s (local.get $base) (i64.const 0))
              (i64.gt_u (i64.add (local.get $base) (i64.const 12))
                        (i64.extend_i32_u (local.get $flen))))
    (then
      (drop (call $fm_fail (i32.const 4) (i32.const 0)))
      (return (i64.const 0))))
  (local.set $n (call $fm_be16 (i32.add (local.get $sfnt) (i32.const 4))))
  (local.set $end
    (i64.add (i64.add (local.get $base) (i64.const 12))
             (i64.mul (i64.extend_i32_u (local.get $n)) (i64.const 16))))
  (if (i64.gt_u (local.get $end) (i64.extend_i32_u (local.get $flen)))
    (then
      (drop (call $fm_fail (i32.const 4) (i32.wrap_i64 (local.get $base))))
      (return (i64.const 0))))
  (block $done
    (loop $scan
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $rec
        (i32.add (i32.add (local.get $sfnt) (i32.const 12))
                 (i32.mul (local.get $i) (i32.const 16))))
      (if (i32.eq (call $fm_be32 (local.get $rec)) (local.get $tag))
        (then
          (local.set $off
            (i64.extend_i32_u (call $fm_be32 (i32.add (local.get $rec) (i32.const 8)))))
          (local.set $len
            (i64.extend_i32_u (call $fm_be32 (i32.add (local.get $rec) (i32.const 12)))))
          (if (i64.gt_u (i64.add (local.get $off) (local.get $len))
                        (i64.extend_i32_u (local.get $flen)))
            (then
              (drop (call $fm_fail (i32.const 4)
                                   (i32.wrap_i64 (local.get $off))))
              (return (i64.const 0))))
          (if (i64.lt_u (local.get $len)
                        (i64.extend_i32_u (local.get $minlen)))
            (then
              (drop (call $fm_fail (i32.const 4)
                                   (i32.wrap_i64 (local.get $off))))
              (return (i64.const 0))))
          (local.set $p
            (i32.wrap_i64
              (i64.add (i64.extend_i32_u (local.get $font))
                       (local.get $off))))
          (return
            (i64.or (i64.extend_i32_u (local.get $p))
                    (i64.shl (local.get $len) (i64.const 32))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $scan)))
  (drop (call $fm_fail (i32.const 3) (local.get $tag)))
  (i64.const 0))

(func $fm_cmap_find (param $font i32) (param $cmap i32) (param $clen i32) (param $wanted i32) (result i64)
