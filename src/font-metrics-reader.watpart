;; Resolves the sfnt header of the requested face. On failure the error code
;; and field are set and the returned pointer is meaningless.
(func $fm_select_face (param $font i32) (param $flen i32) (param $face i32)
  (result i32)
  (local $off i32)
  (if (i32.lt_u (local.get $flen) (i32.const 4))
    (then (drop (call $fm_fail (i32.const 4) (i32.const 0)))
          (return (i32.const 0))))
  (if (i32.ne (call $fm_be32 (local.get $font)) (i32.const 1953784678))
    (then
      (if (i32.ne (local.get $face) (i32.const 0))
        (then (drop (call $fm_fail (i32.const 2) (local.get $face)))))
      (return (local.get $font))))
  (if (i32.lt_u (local.get $flen) (i32.const 12))
    (then (drop (call $fm_fail (i32.const 4) (i32.const 0)))
          (return (i32.const 0))))
  (local.set $off (call $fm_be32 (i32.add (local.get $font) (i32.const 8))))
  (if (i32.or (i32.lt_s (local.get $face) (i32.const 0))
              (i32.ge_u (local.get $face) (local.get $off)))
    (then (drop (call $fm_fail (i32.const 2) (local.get $face)))
          (return (i32.const 0))))
