;; OpenType MATH table reader. Every call resolves the face and the MATH table
;; again, reads only inside that table, and writes one record in the caller's
;; span. Values are font units; device-table deltas are ignored.

;; The MATH table of the current call: address, length, and offset in the font
;; span (the offset names failing fields).
(global $fm_mt (mut i32) (i32.const 0))
(global $fm_ml (mut i32) (i32.const 0))
(global $fm_mo (mut i32) (i32.const 0))

;; Records the first font-data failure at a table-relative offset; answers 0.
(func $fm_mbad (param $rel i32) (result i32)
  (if (i32.eqz (global.get $fm_error))
    (then
      (drop (call $fm_fail (i32.const 4)
                           (i32.add (global.get $fm_mo) (local.get $rel))))))
  (i32.const 0))

;; 1 when [rel, rel + size) lies inside the MATH table, else records a failure.
(func $fm_mneed (param $rel i32) (param $size i64) (result i32)
  (if (i64.gt_u (i64.add (i64.extend_i32_u (local.get $rel)) (local.get $size))
                (i64.extend_i32_u (global.get $fm_ml)))
    (then (return (call $fm_mbad (local.get $rel)))))
  (i32.const 1))

(func $fm_mu16 (param $rel i32) (result i32)
  (if (i32.eqz (call $fm_mneed (local.get $rel) (i64.const 2)))
    (then (return (i32.const 0))))
  (call $fm_be16 (i32.add (global.get $fm_mt) (local.get $rel))))

(func $fm_ms16 (param $rel i32) (result i32)
  (i32.shr_s (i32.shl (call $fm_mu16 (local.get $rel)) (i32.const 16))
             (i32.const 16)))

;; Resolves the Offset16 at $at against the table at $base. A null offset
;; answers 0; no subtable starts at the MATH header.
(func $fm_moff (param $base i32) (param $at i32) (result i32)
  (local $offset i32)
  (local.set $offset (call $fm_mu16 (local.get $at)))
  (if (i32.eqz (local.get $offset)) (then (return (i32.const 0))))
  (i32.add (local.get $base) (local.get $offset)))

;; Validates the caller's spans, selects the face, and binds its MATH table.
(func $fm_math_open (param $font i32) (param $flen i32) (param $face i32)
  (result i32)
  (local $sfnt i32) (local $pack i64)
  (if (i32.eqz (call $fm_span (local.get $font) (local.get $flen)))
    (then (return (call $fm_fail (i32.const 1) (local.get $font)))))
  (local.set $sfnt
    (call $fm_select_face (local.get $font) (local.get $flen) (local.get $face)))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (local.set $pack
    (call $fm_find_table (local.get $font) (local.get $flen) (local.get $sfnt)
                         (i32.const 1296127048) (i32.const 10)))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (global.set $fm_mt (i32.wrap_i64 (local.get $pack)))
  (global.set $fm_ml (i32.wrap_i64 (i64.shr_u (local.get $pack) (i64.const 32))))
  (global.set $fm_mo (i32.sub (global.get $fm_mt) (local.get $font)))
  (if (i32.ne (call $fm_mu16 (i32.const 0)) (i32.const 1))
    (then (return (call $fm_fail (i32.const 4) (global.get $fm_mo)))))
  (i32.const 0))

;; Clears the error state and a result record of $size bytes.
(func $fm_math_result (param $result i32) (param $size i32) (result i32)
  (global.set $fm_error (i32.const 0))
  (global.set $fm_field (i32.const 0))
  (if (i32.eqz (call $fm_span (local.get $result) (local.get $size)))
    (then (return (call $fm_fail (i32.const 1) (local.get $result)))))
  (memory.fill (local.get $result) (i32.const 0) (local.get $size))
  (i32.const 0))

;; Coverage index of $glyph in the Coverage table at $rel, or -1. A null
;; table or an unknown format covers nothing.
(func $fm_coverage (param $rel i32) (param $glyph i32) (result i32)
  (local $format i32) (local $count i32) (local $low i32) (local $high i32)
  (local $mid i32) (local $at i32) (local $first i32)
  (if (i32.or (i32.eqz (local.get $rel))
              (i32.gt_u (local.get $glyph) (i32.const 65535)))
    (then (return (i32.const -1))))
  (local.set $format (call $fm_mu16 (local.get $rel)))
  (local.set $count (call $fm_mu16 (i32.add (local.get $rel) (i32.const 2))))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (i32.const -1))))
  (local.set $high (local.get $count))
  (if (i32.eq (local.get $format) (i32.const 1))
    (then
      (if (i32.eqz
            (call $fm_mneed (i32.add (local.get $rel) (i32.const 4))
                            (i64.mul (i64.extend_i32_u (local.get $count))
                                     (i64.const 2))))
        (then (return (i32.const -1))))
      (block $done
        (loop $search
          (br_if $done (i32.ge_u (local.get $low) (local.get $high)))
          (local.set $mid
            (i32.shr_u (i32.add (local.get $low) (local.get $high)) (i32.const 1)))
          (local.set $first
            (call $fm_be16
              (i32.add (i32.add (global.get $fm_mt) (local.get $rel))
                       (i32.add (i32.const 4)
                                (i32.shl (local.get $mid) (i32.const 1))))))
          (if (i32.eq (local.get $first) (local.get $glyph))
            (then (return (local.get $mid))))
          (if (i32.lt_u (local.get $first) (local.get $glyph))
            (then (local.set $low (i32.add (local.get $mid) (i32.const 1))))
            (else (local.set $high (local.get $mid))))
          (br $search)))
      (return (i32.const -1))))
  (if (i32.eq (local.get $format) (i32.const 2))
    (then
      (if (i32.eqz
            (call $fm_mneed (i32.add (local.get $rel) (i32.const 4))
                            (i64.mul (i64.extend_i32_u (local.get $count))
                                     (i64.const 6))))
        (then (return (i32.const -1))))
      (block $done
        (loop $search
          (br_if $done (i32.ge_u (local.get $low) (local.get $high)))
          (local.set $mid
            (i32.shr_u (i32.add (local.get $low) (local.get $high)) (i32.const 1)))
          (local.set $at
            (i32.add (i32.add (global.get $fm_mt) (local.get $rel))
                     (i32.add (i32.const 4)
                              (i32.mul (local.get $mid) (i32.const 6)))))
          (local.set $first (call $fm_be16 (local.get $at)))
          (if (i32.lt_u (local.get $glyph) (local.get $first))
            (then (local.set $high (local.get $mid)))
            (else
              (if (i32.gt_u (local.get $glyph)
                            (call $fm_be16 (i32.add (local.get $at) (i32.const 2))))
                (then (local.set $low (i32.add (local.get $mid) (i32.const 1))))
                (else
                  (return
                    (i32.add (call $fm_be16 (i32.add (local.get $at) (i32.const 4)))
                             (i32.sub (local.get $glyph) (local.get $first))))))))
          (br $search)))))
  (i32.const -1))

(func $font_metrics_math_constants (export "font_metrics_math_constants")
  (param $font i32) (param $flen i32) (param $face i32) (param $result i32)
  (result i32)
  (local $status i32) (local $constants i32) (local $variants i32)
  (local $index i32) (local $value i32)
  (local.set $status (call $fm_math_result (local.get $result) (i32.const 228)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $status
    (call $fm_math_open (local.get $font) (local.get $flen) (local.get $face)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $constants (call $fm_moff (i32.const 0) (i32.const 4)))
  (if (i32.and (i32.ne (local.get $constants) (i32.const 0))
               (call $fm_mneed (local.get $constants) (i64.const 214)))
    (then
      (block $done
        (loop $each
          (br_if $done (i32.ge_u (local.get $index) (i32.const 56)))
          (if (i32.lt_u (local.get $index) (i32.const 2))
            (then
              (local.set $value
                (call $fm_ms16
                  (i32.add (local.get $constants)
                           (i32.shl (local.get $index) (i32.const 1))))))
            (else
              (if (i32.lt_u (local.get $index) (i32.const 4))
                (then
                  (local.set $value
                    (call $fm_mu16
                      (i32.add (local.get $constants)
                               (i32.shl (local.get $index) (i32.const 1))))))
                (else
                  (if (i32.eq (local.get $index) (i32.const 55))
                    (then
                      (local.set $value
                        (call $fm_ms16
                          (i32.add (local.get $constants) (i32.const 212)))))
                    (else
                      (local.set $value
                        (call $fm_ms16
                          (i32.add (local.get $constants)
                                   (i32.add (i32.const 8)
                                            (i32.shl
                                              (i32.sub (local.get $index)
                                                       (i32.const 4))
                                              (i32.const 2))))))))))))
          (i32.store
            (i32.add (local.get $result)
                     (i32.shl (local.get $index) (i32.const 2)))
            (local.get $value))
          (local.set $index (i32.add (local.get $index) (i32.const 1)))
          (br $each)))))
  (local.set $variants (call $fm_moff (i32.const 0) (i32.const 8)))
  (if (local.get $variants)
    (then
      (i32.store offset=224 (local.get $result)
        (call $fm_mu16 (local.get $variants)))))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (i32.const 0))

;; The MathKern subtable of $glyph for $corner, or 0.
(func $fm_math_kern_table (param $glyph i32) (param $corner i32) (result i32)
  (local $info i32) (local $kerns i32) (local $index i32)
  (local.set $info (call $fm_moff (i32.const 0) (i32.const 6)))
  (if (i32.eqz (local.get $info)) (then (return (i32.const 0))))
  (local.set $kerns
    (call $fm_moff (local.get $info) (i32.add (local.get $info) (i32.const 6))))
  (if (i32.eqz (local.get $kerns)) (then (return (i32.const 0))))
  (local.set $index
    (call $fm_coverage (call $fm_moff (local.get $kerns) (local.get $kerns))
                       (local.get $glyph)))
  (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
              (i32.ge_u (local.get $index)
                        (call $fm_mu16 (i32.add (local.get $kerns) (i32.const 2)))))
    (then (return (i32.const 0))))
  (call $fm_moff (local.get $kerns)
    (i32.add (local.get $kerns)
             (i32.add (i32.const 4)
                      (i32.add (i32.shl (local.get $index) (i32.const 3))
                               (i32.shl (local.get $corner) (i32.const 1)))))))

(func $font_metrics_math_glyph (export "font_metrics_math_glyph")
  (param $font i32) (param $flen i32) (param $face i32) (param $glyph i32)
  (param $result i32) (result i32)
  (local $status i32) (local $info i32) (local $table i32) (local $index i32)
  (local $flags i32) (local $corner i32) (local $kern i32)
  (local.set $status (call $fm_math_result (local.get $result) (i32.const 32)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $status
    (call $fm_math_open (local.get $font) (local.get $flen) (local.get $face)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $info (call $fm_moff (i32.const 0) (i32.const 6)))
  (if (local.get $info)
    (then
      ;; MathItalicsCorrectionInfo, then MathTopAccentAttachment: a coverage
      ;; offset, a count, and one MathValueRecord per covered glyph.
      (local.set $table (call $fm_moff (local.get $info) (local.get $info)))
      (if (local.get $table)
        (then
          (local.set $index
            (call $fm_coverage (call $fm_moff (local.get $table) (local.get $table))
                               (local.get $glyph)))
          (if (i32.ge_s (local.get $index) (i32.const 0))
            (then
              (local.set $flags (i32.or (local.get $flags) (i32.const 1)))
              (if (i32.lt_u (local.get $index)
                            (call $fm_mu16 (i32.add (local.get $table) (i32.const 2))))
                (then
                  (i32.store offset=4 (local.get $result)
                    (call $fm_ms16
                      (i32.add (local.get $table)
                               (i32.add (i32.const 4)
                                        (i32.shl (local.get $index) (i32.const 2))))))))))))
      (local.set $table
        (call $fm_moff (local.get $info) (i32.add (local.get $info) (i32.const 2))))
      (if (local.get $table)
        (then
          (local.set $index
            (call $fm_coverage (call $fm_moff (local.get $table) (local.get $table))
                               (local.get $glyph)))
          (if (i32.ge_s (local.get $index) (i32.const 0))
            (then
              (local.set $flags (i32.or (local.get $flags) (i32.const 2)))
              (if (i32.lt_u (local.get $index)
                            (call $fm_mu16 (i32.add (local.get $table) (i32.const 2))))
                (then
                  (i32.store offset=8 (local.get $result)
                    (call $fm_ms16
                      (i32.add (local.get $table)
                               (i32.add (i32.const 4)
                                        (i32.shl (local.get $index) (i32.const 2))))))))))))
      (if (i32.ge_s
            (call $fm_coverage
              (call $fm_moff (local.get $info) (i32.add (local.get $info) (i32.const 4)))
              (local.get $glyph))
            (i32.const 0))
        (then (local.set $flags (i32.or (local.get $flags) (i32.const 4)))))
      (block $done
        (loop $corners
          (br_if $done (i32.ge_u (local.get $corner) (i32.const 4)))
          (local.set $kern
            (call $fm_math_kern_table (local.get $glyph) (local.get $corner)))
          (if (local.get $kern)
            (then
              (local.set $flags (i32.or (local.get $flags) (i32.const 8)))
              (i32.store offset=12
                (i32.add (local.get $result)
                         (i32.shl (local.get $corner) (i32.const 2)))
                (i32.add (call $fm_mu16 (local.get $kern)) (i32.const 1)))))
          (local.set $corner (i32.add (local.get $corner) (i32.const 1)))
          (br $corners)))))
  (i32.store (local.get $result) (local.get $flags))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (i32.const 0))

;; Validates a list call: a capacity of 0 to 65536 entries and a result span of
;; $header + capacity * $entry bytes. Clears the header.
(func $fm_math_list (param $capacity i32) (param $result i32)
  (param $header i32) (param $entry i32) (result i32)
  (global.set $fm_error (i32.const 0))
  (global.set $fm_field (i32.const 0))
  (if (i32.gt_u (local.get $capacity) (i32.const 65536))
    (then (return (call $fm_fail (i32.const 7) (local.get $capacity)))))
  (if (i32.eqz
        (call $fm_span (local.get $result)
          (i32.add (local.get $header)
                   (i32.mul (local.get $capacity) (local.get $entry)))))
    (then (return (call $fm_fail (i32.const 1) (local.get $result)))))
  (memory.fill (local.get $result) (i32.const 0) (local.get $header))
  (i32.const 0))

(func $font_metrics_math_kern (export "font_metrics_math_kern")
  (param $font i32) (param $flen i32) (param $face i32) (param $glyph i32)
  (param $corner i32) (param $start i32) (param $capacity i32)
  (param $result i32) (result i32)
  (local $status i32) (local $kern i32) (local $heights i32) (local $total i32)
  (local $index i32) (local $written i32) (local $out i32)
  (local.set $status
    (call $fm_math_list (local.get $capacity) (local.get $result)
                        (i32.const 8) (i32.const 8)))
  (if (local.get $status) (then (return (local.get $status))))
  (if (i32.gt_u (local.get $corner) (i32.const 3))
    (then (return (call $fm_fail (i32.const 7) (local.get $corner)))))
  (local.set $status
    (call $fm_math_open (local.get $font) (local.get $flen) (local.get $face)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $kern (call $fm_math_kern_table (local.get $glyph) (local.get $corner)))
  (if (local.get $kern)
    (then
      ;; MathKern: heightCount, heightCount correction heights, then
      ;; heightCount + 1 kern values, all MathValueRecords.
      (local.set $heights (call $fm_mu16 (local.get $kern)))
      (local.set $total (i32.add (local.get $heights) (i32.const 1)))
      (if (call $fm_mneed (i32.add (local.get $kern) (i32.const 2))
            (i64.mul (i64.extend_i32_u
                       (i32.add (i32.shl (local.get $heights) (i32.const 1))
                                (i32.const 1)))
                     (i64.const 4)))
        (then
          (local.set $index (local.get $start))
          (block $done
            (loop $each
              (br_if $done (i32.ge_u (local.get $index) (local.get $total)))
              (br_if $done (i32.ge_u (local.get $written) (local.get $capacity)))
              (local.set $out
                (i32.add (local.get $result)
                         (i32.add (i32.const 8)
                                  (i32.shl (local.get $written) (i32.const 3)))))
              (if (i32.eq (local.get $index) (local.get $heights))
                (then (i32.store (local.get $out) (i32.const 0x7fffffff)))
                (else
                  (i32.store (local.get $out)
                    (call $fm_ms16
                      (i32.add (local.get $kern)
                               (i32.add (i32.const 2)
                                        (i32.shl (local.get $index) (i32.const 2))))))))
              (i32.store offset=4 (local.get $out)
                (call $fm_ms16
                  (i32.add (local.get $kern)
                           (i32.add (i32.const 2)
                                    (i32.shl (i32.add (local.get $heights)
                                                      (local.get $index))
                                             (i32.const 2))))))
              (local.set $written (i32.add (local.get $written) (i32.const 1)))
              (local.set $index (i32.add (local.get $index) (i32.const 1)))
              (br $each)))))))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (i32.store (local.get $result) (local.get $total))
  (i32.store offset=4 (local.get $result) (local.get $written))
  (i32.const 0))

;; The MathGlyphConstruction of $glyph in one direction, or 0.
(func $fm_math_construction (param $glyph i32) (param $horizontal i32)
  (result i32)
  (local $variants i32) (local $vertical i32) (local $index i32) (local $count i32)
  (local.set $variants (call $fm_moff (i32.const 0) (i32.const 8)))
  (if (i32.eqz (local.get $variants)) (then (return (i32.const 0))))
  (local.set $vertical
    (call $fm_mu16 (i32.add (local.get $variants) (i32.const 6))))
  (local.set $count
    (call $fm_mu16
      (i32.add (local.get $variants)
               (select (i32.const 8) (i32.const 6) (local.get $horizontal)))))
  (local.set $index
    (call $fm_coverage
      (call $fm_moff (local.get $variants)
        (i32.add (local.get $variants)
                 (select (i32.const 4) (i32.const 2) (local.get $horizontal))))
      (local.get $glyph)))
  (if (i32.or (i32.lt_s (local.get $index) (i32.const 0))
              (i32.ge_u (local.get $index) (local.get $count)))
    (then (return (i32.const 0))))
  (if (local.get $horizontal)
    (then (local.set $index (i32.add (local.get $index) (local.get $vertical)))))
  (call $fm_moff (local.get $variants)
    (i32.add (local.get $variants)
             (i32.add (i32.const 10) (i32.shl (local.get $index) (i32.const 1))))))

(func $font_metrics_math_variants (export "font_metrics_math_variants")
  (param $font i32) (param $flen i32) (param $face i32) (param $glyph i32)
  (param $horizontal i32) (param $start i32) (param $capacity i32)
  (param $result i32) (result i32)
  (local $status i32) (local $construction i32) (local $total i32)
  (local $index i32) (local $written i32) (local $at i32) (local $out i32)
  (local.set $status
    (call $fm_math_list (local.get $capacity) (local.get $result)
                        (i32.const 8) (i32.const 8)))
  (if (local.get $status) (then (return (local.get $status))))
  (if (i32.gt_u (local.get $horizontal) (i32.const 1))
    (then (return (call $fm_fail (i32.const 7) (local.get $horizontal)))))
  (local.set $status
    (call $fm_math_open (local.get $font) (local.get $flen) (local.get $face)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $construction
    (call $fm_math_construction (local.get $glyph) (local.get $horizontal)))
  (if (local.get $construction)
    (then
      (local.set $total
        (call $fm_mu16 (i32.add (local.get $construction) (i32.const 2))))
      (if (call $fm_mneed (i32.add (local.get $construction) (i32.const 4))
            (i64.mul (i64.extend_i32_u (local.get $total)) (i64.const 4)))
        (then
          (local.set $index (local.get $start))
          (block $done
            (loop $each
              (br_if $done (i32.ge_u (local.get $index) (local.get $total)))
              (br_if $done (i32.ge_u (local.get $written) (local.get $capacity)))
              (local.set $at
                (i32.add (global.get $fm_mt)
                         (i32.add (local.get $construction)
                                  (i32.add (i32.const 4)
                                           (i32.shl (local.get $index) (i32.const 2))))))
              (local.set $out
                (i32.add (local.get $result)
                         (i32.add (i32.const 8)
                                  (i32.shl (local.get $written) (i32.const 3)))))
              (i32.store (local.get $out) (call $fm_be16 (local.get $at)))
              (i32.store offset=4 (local.get $out)
                (call $fm_be16 (i32.add (local.get $at) (i32.const 2))))
              (local.set $written (i32.add (local.get $written) (i32.const 1)))
              (local.set $index (i32.add (local.get $index) (i32.const 1)))
              (br $each)))))))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (i32.store (local.get $result) (local.get $total))
  (i32.store offset=4 (local.get $result) (local.get $written))
  (i32.const 0))

(func $font_metrics_math_assembly (export "font_metrics_math_assembly")
  (param $font i32) (param $flen i32) (param $face i32) (param $glyph i32)
  (param $horizontal i32) (param $start i32) (param $capacity i32)
  (param $result i32) (result i32)
  (local $status i32) (local $construction i32) (local $assembly i32)
  (local $total i32) (local $index i32) (local $written i32) (local $at i32)
  (local $out i32)
  (local.set $status
    (call $fm_math_list (local.get $capacity) (local.get $result)
                        (i32.const 16) (i32.const 20)))
  (if (local.get $status) (then (return (local.get $status))))
  (if (i32.gt_u (local.get $horizontal) (i32.const 1))
    (then (return (call $fm_fail (i32.const 7) (local.get $horizontal)))))
  (local.set $status
    (call $fm_math_open (local.get $font) (local.get $flen) (local.get $face)))
  (if (local.get $status) (then (return (local.get $status))))
  (local.set $construction
    (call $fm_math_construction (local.get $glyph) (local.get $horizontal)))
  (if (local.get $construction)
    (then
      (local.set $assembly
        (call $fm_moff (local.get $construction) (local.get $construction)))))
  (if (local.get $assembly)
    (then
      ;; GlyphAssembly: italicsCorrection MathValueRecord, partCount, then
      ;; GlyphPart records of five uint16 fields.
      (i32.store offset=8 (local.get $result) (call $fm_ms16 (local.get $assembly)))
      (local.set $total
        (call $fm_mu16 (i32.add (local.get $assembly) (i32.const 4))))
      (if (call $fm_mneed (i32.add (local.get $assembly) (i32.const 6))
            (i64.mul (i64.extend_i32_u (local.get $total)) (i64.const 10)))
        (then
          (local.set $index (local.get $start))
          (block $done
            (loop $each
              (br_if $done (i32.ge_u (local.get $index) (local.get $total)))
              (br_if $done (i32.ge_u (local.get $written) (local.get $capacity)))
              (local.set $at
                (i32.add (global.get $fm_mt)
                         (i32.add (local.get $assembly)
                                  (i32.add (i32.const 6)
                                           (i32.mul (local.get $index) (i32.const 10))))))
              (local.set $out
                (i32.add (local.get $result)
                         (i32.add (i32.const 16)
                                  (i32.mul (local.get $written) (i32.const 20)))))
              (i32.store (local.get $out) (call $fm_be16 (local.get $at)))
              (i32.store offset=4 (local.get $out)
                (call $fm_be16 (i32.add (local.get $at) (i32.const 2))))
              (i32.store offset=8 (local.get $out)
                (call $fm_be16 (i32.add (local.get $at) (i32.const 4))))
              (i32.store offset=12 (local.get $out)
                (call $fm_be16 (i32.add (local.get $at) (i32.const 6))))
              (i32.store offset=16 (local.get $out)
                (call $fm_be16 (i32.add (local.get $at) (i32.const 8))))
              (local.set $written (i32.add (local.get $written) (i32.const 1)))
              (local.set $index (i32.add (local.get $index) (i32.const 1)))
              (br $each)))))))
  (if (i32.ne (global.get $fm_error) (i32.const 0))
    (then (return (global.get $fm_error))))
  (i32.store (local.get $result) (local.get $total))
  (i32.store offset=4 (local.get $result) (local.get $written))
  (i32.const 0))
